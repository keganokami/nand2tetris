/**
 * テトリス - メインエントリーポイント
 *
 * Nand2Tetrisの集大成として、NANDゲートから構築した
 * コンピューターシステム上で動作するテトリスゲーム
 *
 * 操作方法:
 *   ←→: 左右移動
 *   ↓: ソフトドロップ
 *   ↑/Z: 時計回り回転
 *   X: 反時計回り回転
 *   スペース: ハードドロップ
 *   Q: 終了
 */
class Main {

    /** プログラムのエントリーポイント */
    function void main() {
        var Game game;

        // ゲームを生成して実行
        let game = Game.new();
        do game.run();
        do game.dispose();

        return;
    }
}
